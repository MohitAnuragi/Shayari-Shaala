<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.ShayariShaala" parent="android:Theme.Material.Light.NoActionBar">
        <!-- Paper UI: dark status/navigation bar icons (the splash library re-applies these on exit) -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>

    <!-- System splash (API 31+ native, backported below): paper so it blends into the Compose splash -->
    <style name="Theme.ShayariShaala.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/paper</item>
        <item name="postSplashScreenTheme">@style/Theme.ShayariShaala</item>
    </style>
</resources>